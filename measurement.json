  "method_steps": [
    "Read the last 2–4 quarters of ticket and escalation history: escalation rate, repeat rate by cause, time to resolve, open lessons and defects, and customer signal.",
    "Talk with support engineers, the account team, engineering leads, and a few customers.",
    "When the tags disagree, write the definitions down and tag every new case the same way from day one.",
    "If the older quarters do not share those definitions, the first full quarter of consistent tagging is the baseline."
  ],
  "messy_data": "These example quarters already share the definitions below, so their average is the baseline. That is the clean case. When older tags disagree, they stay as context and the first full quarter of consistent tagging becomes the baseline.",
  "definitions": [
    {
      "term": "Escalation",
      "means": "A customer issue that left the normal support path and was accepted by the escalation manager."
    },
    {
      "term": "Repeat",
      "means": "A later case with the same confirmed mechanism and the same product surface as a lesson that was already verified. The lesson reopens."
    },
    {
      "term": "Routed on time",
      "means": "A named owner and an owner type assigned within 5 days of the lesson opening."
    },
    {
      "term": "First honest update",
      "means": "The first customer-facing update a person approved that stays inside what the product can actually do."
    },
    {
      "term": "Field solve",
      "means": "An issue closed with a field tool or check, with no escalation opened."
    },
    {
      "term": "Lesson closed",
      "means": "The owner verified the evidence, and the lesson is not sitting in rework."
    },
    {
      "term": "Accepted",
      "means": "The owner team has the lesson in its own system, and that record links back to the lesson."
    },
    {
      "term": "Implemented",
      "means": "The change, training, tool, procedure, or guide is in place."
    },
    {
      "term": "Held",
      "means": "The lesson is verified, and the same confirmed mechanism has not come back for 30 days. A recurrence reopens it."
    }
  ],
  "conversations": [
    {
      "role": "Support engineer",
      "note": "Missing-template and discarded-draft reports were closed under one symptom, so a repeat count would have mixed two causes."
    },
    {
      "role": "Account team",
      "note": "Customers remember the first update. A promise the product cannot keep makes the next conversation harder."
    },
    {
      "role": "Engineering lead",
      "note": "A merged change is not the path the customer hit. The replay has to pass before the fix counts."
    },
    {
      "role": "Customer, Example Privacy Team",
      "note": "Say what is known, what is not known, and when the template will be usable again."
    }
